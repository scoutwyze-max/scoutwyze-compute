{
  "name": "@scoutwyze/compute-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "MCP (Model Context Protocol) server for ScoutWyze Compute — ranks current RunPod GPU offers by price and freshness, with native x402/USDC-on-Base micropayment support. Stateless pass-through: holds no private keys, never signs or settles a payment itself.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gpu",
    "compute",
    "x402",
    "scoutwyze",
    "runpod",
    "ai-agent"
  ],
  "homepage": "https://scoutwyze-compute.fly.dev",
  "bugs": {
    "url": "https://github.com/scoutwyze-max/scoutwyze-compute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoutwyze-max/scoutwyze-compute.git",
    "directory": "mcp-server"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "scoutwyze-compute-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
