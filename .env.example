# ScoutWyze Compute — environment variables (V1)
# Copy to .env for local development. Never commit .env.

PORT=8787

# SQLite file backing API keys, the credit ledger, and x402 challenge
# nonces (src/db/connection.ts) — durable across restarts. The parent
# directory is created automatically if it doesn't exist.
DATABASE_PATH=./data/scoutwyze-compute.db

# Primary auth rail — real hashed API keys backed by a prepaid credit
# ledger (src/billing/). No keys are pre-seeded via env anymore; issue
# one via POST /v1/admin/api-keys (see ADMIN_SECRET below).

# Shared secret for the /v1/admin/* routes (key issuance, credit top-ups,
# ledger visibility) — a SEPARATE credential space from customer API
# keys. Falls back to an insecure dev-only default with a loud startup
# warning if unset; must be set for any real deployment.
ADMIN_SECRET=

# Per-route price in USD, shared by both auth rails (Bearer/credits and
# x402/USDC) so there's one "cost of a quote" instead of two that could
# drift. Falls back to $0.15 if unset (within CLAUDE.md's $0.10-$0.25+ range).
ROUTE_PRICE_USDC=0.15

# Background ingestion cache refresh interval, in seconds.
INGESTION_REFRESH_INTERVAL_SECONDS=60

# Quote response TTL, in seconds — how long a served quote is considered fresh.
QUOTE_TTL_SECONDS=300

# Strict cache-entry TTL, in seconds — how long ingested provider data is
# trusted before the cache itself refuses to serve it (marked "stale",
# excluded from quotes) regardless of ingestion refresh interval or quote
# TTL above. Defaults to 3x INGESTION_REFRESH_INTERVAL_SECONDS if unset.
CACHE_TTL_SECONDS=180

# HMAC signing secret for x402 payment receipts (src/api/middleware/x402.ts).
# Falls back to an insecure dev-only default if unset — must be set for
# any real deployment, or a signed receipt from one process/restart isn't
# verifiable by another.
X402_RECEIPT_SIGNING_SECRET=

# x402 / Base — REAL on-chain settlement verification (src/payments/
# baseVerification.ts), not mocked. Not secrets — a receiving address
# and an RPC endpoint are both meant to be public.
# Real treasury wallet, Robert 2026-09-21 — falls back to this exact
# value if unset, so it's only here for override/documentation, not
# because it needs to be kept out of source (payTo is advertised in
# every 402 challenge response anyway).
BASE_TREASURY_ADDRESS=0xc132a315a05541a4b72c272de539eb86de977fb9
# Base's public RPC (free, rate-limited) by default. Point this at a
# real provider (Alchemy/Infura/etc.) for production volume without
# any code change.
BASE_RPC_URL=https://mainnet.base.org

# Stripe webhook signing secret (src/payments/stripeWebhook.ts) — from
# the Stripe Dashboard's webhook endpoint config. Deliberately NO
# insecure dev-only fallback: unlike the other secrets above, a
# guessable default here would mean anyone could forge a "payment
# succeeded" event and mint themselves free credits. Unset means the
# webhook route rejects everything (loud, safe) rather than silently
# accepting unsigned requests.
STRIPE_WEBHOOK_SECRET=

# Customer-facing signup/checkout (src/api/routes/signup.ts,
# src/payments/stripeCheckout.ts) — POST /v1/signup issues a free API
# key + account; POST /v1/checkout-sessions creates a real Stripe
# Checkout Session to fund it. STRIPE_SECRET_KEY is a genuine secret
# (server-side Stripe API key, starts with sk_) — unset means every
# checkout session creation fails loudly (502), never silently.
STRIPE_SECRET_KEY=
# Where Stripe redirects the customer after a real payment. No real
# default — there's no front-end page at either URL yet (outside this
# repo's scope); unset falls back to an obvious example.com placeholder
# and logs a startup warning rather than guessing a real scoutwyze.com path.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
