# ScoutWyze Compute — environment variables (V1)
# Copy to .env for local development. Never commit .env.

PORT=8787

# Primary auth rail — comma-separated list of valid API keys for local/dev use.
# Production would back this with a real credit-ledger table, not an env list.
SCOUTWYZE_API_KEYS=dev_test_key_local_only

# Background ingestion cache refresh interval, in seconds.
INGESTION_REFRESH_INTERVAL_SECONDS=60

# Quote response TTL, in seconds — how long a served quote is considered fresh.
QUOTE_TTL_SECONDS=300

# x402 / Base network settlement — V1 scaffolds this rail but mocks on-chain
# verification. These are placeholders for when real settlement is wired in.
X402_MOCK_MODE=true
X402_FACILITATOR_URL=
BASE_NETWORK_RPC_URL=
X402_RECEIVING_ADDRESS=
