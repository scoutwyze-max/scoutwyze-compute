{
  "name": "scoutwyze-compute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous GPU placement recommendation and routing decision engine for AI infrastructure agents and MLOps pipelines.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run copy-fixtures",
    "copy-fixtures": "mkdir -p dist/providers/fixtures && cp src/providers/fixtures/*.json dist/providers/fixtures/",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.1",
    "ethers": "^6.17.0",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
